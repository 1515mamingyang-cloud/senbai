# ===== 森柏后端配置 =====
# 复制本文件为 .env 并填入真实值

# ---------- 数据库 ----------
# 方式 1（本地开发）：SQLite，零配置
DATABASE_URL=sqlite:///./senbai.db

# 方式 2（微信云托管生产）：MySQL
# 在云托管控制台创建 MySQL 后，会自动注入以下变量，无需手动设置 DATABASE_URL：
#   MYSQL_HOST / MYSQL_PORT / MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE
# 或者手动指定完整连接串：
# DATABASE_URL=mysql+pymysql://用户名:密码@地址:3306/senbai?charset=utf8mb4

# ---------- 认证 ----------
# JWT 密钥（生产环境务必改成一串随机字符串）
SECRET_KEY=senbai-dev-secret-key-please-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------- 大模型 API ----------
# OpenAI 兼容接口，智谱/通义/Kimi/DeepSeek 都支持
# 智谱: https://open.bigmodel.cn/api/paas/v4
# 通义: https://dashscope.aliyuncs.com/compatible-mode/v1
# Kimi: https://api.moonshot.cn/v1
# DeepSeek: https://api.deepseek.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=填入你的key
LLM_MODEL=deepseek-chat

# ---------- 爬虫 ----------
# 每天几点执行抓取（24小时制，默认早8点）
CRAWL_CRON_HOUR=8

# ---------- 初始管理员账号（云托管首次启动时自动创建）----------
# 留空则不自动创建，需手动运行 create_user.py
INIT_ADMIN_USERNAME=
INIT_ADMIN_PASSWORD=
