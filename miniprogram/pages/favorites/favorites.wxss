/* pages/favorites/favorites.wxss */
.favorites-page {
  min-height: 100vh;
  padding: 24rpx 0;
}

.fav-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 24rpx 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.fav-card:active {
  background: #f9f9f9;
}

.fav-summary {
  background: #e8f5e9;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: flex-start;
}

.summary-tag {
  background: #2db84d;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  line-height: 1.6;
}

.summary-text {
  font-size: 26rpx;
  color: #2e7d32;
  line-height: 1.6;
  flex: 1;
}

.fav-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #222;
  line-height: 1.5;
}

.fav-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}

.fav-source {
  color: #2db84d;
  font-size: 24rpx;
}

.fav-time {
  color: #bbb;
  font-size: 22rpx;
}

.empty {
  text-align: center;
  padding: 160rpx 0;
  color: #ccc;
}

.empty-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
}
