/* pages/index/index.wxss */
.index-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ========== 顶部区域 ========== */
.header {
  background: linear-gradient(135deg, #2db84d 0%, #25993f 100%);
  padding: 36rpx 32rpx 40rpx;
  color: #fff;
}

.header-top {
  display: flex;
  align-items: center;
}

/* 小猫头像 */
.cat-avatar-wrap {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.cat-avatar {
  width: 100%;
  height: 100%;
  display: block;
}

/* 小猫互动动画 */
@keyframes catShake {
  0% { transform: rotate(0deg) scale(1); }
  20% { transform: rotate(-12deg) scale(1.15); }
  40% { transform: rotate(12deg) scale(1.15); }
  60% { transform: rotate(-8deg) scale(1.1); }
  80% { transform: rotate(8deg) scale(1.05); }
  100% { transform: rotate(0deg) scale(1); }
}

.cat-animate {
  animation: catShake 0.6s ease-in-out;
}

/* 问候语 */
.header-info {
  flex: 1;
  margin-left: 20rpx;
}

.header-greeting {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
}

.header-sub {
  display: block;
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}

/* 获取精选按钮 */
.refresh-btn {
  flex-shrink: 0;
  background: #fff;
  color: #2db84d;
  font-size: 24rpx;
  font-weight: 600;
  border: none;
  border-radius: 30rpx;
  padding: 12rpx 28rpx;
  line-height: 1.5;
}

.refresh-btn.refreshing {
  opacity: 0.6;
}

.refresh-btn::after {
  border: none;
}

/* ========== 互动按钮 ========== */
.cat-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}

.cat-action-btn {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
}

.cat-action-btn:active {
  background: rgba(255, 255, 255, 0.35);
  transform: scale(0.95);
}

.cat-action-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.cat-action-label {
  font-size: 24rpx;
  color: #fff;
}

/* ========== 撒娇气泡 ========== */
@keyframes bubblePop {
  0% { opacity: 0; transform: translateY(20rpx) scale(0.8); }
  40% { opacity: 1; transform: translateY(0) scale(1.08); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

.cat-bubble {
  display: inline-block;
  background: #fff;
  color: #ff6b35;
  font-size: 26rpx;
  font-weight: 500;
  padding: 16rpx 28rpx;
  border-radius: 24rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
  position: relative;
}

.cat-bubble::before {
  content: "";
  position: absolute;
  top: -12rpx;
  left: 40rpx;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 12rpx solid #fff;
}

.cat-bubble.show {
  animation: bubblePop 0.3s ease-out;
}

/* 日期 */
.header-date {
  display: block;
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 20rpx;
}

/* ========== 精选列表 ========== */
.industry-section {
  margin-top: 32rpx;
}

.industry-header {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  margin-bottom: 16rpx;
}

.industry-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.industry-count {
  font-size: 22rpx;
  color: #999;
  margin-left: 12rpx;
}

/* 精选卡片 */
.article-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 24rpx 20rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.article-card:active {
  background: #f9f9f9;
}

/* AI 总结区域 */
.article-summary {
  background: #e8f5e9;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: flex-start;
}

.summary-tag {
  background: #2db84d;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  line-height: 1.6;
}

.summary-text {
  font-size: 26rpx;
  color: #2e7d32;
  line-height: 1.6;
  flex: 1;
}

/* 文章标题 */
.article-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #222;
  line-height: 1.5;
}

/* AI 观点 */
.insights {
  margin-top: 16rpx;
}

.insight-item {
  margin-bottom: 12rpx;
}

.insight-point {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #555;
  margin-bottom: 4rpx;
}

.insight-desc {
  display: block;
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

/* 底部信息 */
.article-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.article-source {
  color: #2db84d;
  font-size: 24rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 160rpx 0;
  color: #ccc;
}

.empty-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}
