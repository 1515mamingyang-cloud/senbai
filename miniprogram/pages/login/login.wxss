/* pages/login/login.wxss */
.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  background: linear-gradient(180deg, #e8f5e9 0%, #f5f7f5 40%);
  padding: 0 60rpx;
}

.logo-area {
  text-align: center;
  margin-top: 180rpx;
  margin-bottom: 80rpx;
}

.logo-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.logo-text {
  font-size: 56rpx;
  font-weight: 700;
  color: #2db84d;
  letter-spacing: 8rpx;
}

.logo-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
}

.form-area {
  width: 100%;
}

.input-group {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #e0e0e0;
}

.input {
  height: 96rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
}

.placeholder {
  color: #ccc;
}

.login-btn {
  margin-top: 16rpx;
}
