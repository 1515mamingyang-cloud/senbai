<!-- pages/login/login.wxml - 登录页 -->
<view class="login-page">
  <view class="logo-area">
    <view class="logo-icon">🌿</view>
    <view class="logo-text">森柏</view>
    <view class="logo-desc">产业资讯，一目了然</view>
  </view>

  <view class="form-area">
    <view class="input-group">
      <input
        class="input"
        placeholder="用户名"
        value="{{username}}"
        bindinput="onUsernameInput"
        placeholder-class="placeholder"
      />
    </view>
    <view class="input-group">
      <input
        class="input"
        placeholder="密码"
        password="true"
        value="{{password}}"
        bindinput="onPasswordInput"
        placeholder-class="placeholder"
      />
    </view>

    <view class="btn-primary login-btn" bindtap="handleLogin">
      {{loading ? '登录中...' : '登 录'}}
    </view>

    <view class="register-link" bindtap="goRegister">
      还没有账号？去注册
    </view>
  </view>
</view>
