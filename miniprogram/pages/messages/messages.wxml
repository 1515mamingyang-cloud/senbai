<!-- pages/messages/messages.wxml - 留言板 -->
<view class="messages-page">

  <!-- 留言列表 -->
  <view class="message-list">
    <view class="message-item {{item.is_mine ? 'mine' : ''}}" wx:for="{{messages}}" wx:key="id">
      <view class="message-header">
        <text class="message-username">{{item.username}}</text>
        <view class="header-right">
          <text class="visibility-badge" wx:if="{{item.visibility === 'targeted'}}">定向</text>
          <text class="message-time">{{item.created_at}}</text>
        </view>
      </view>
      <view class="message-content">{{item.content}}</view>
    </view>

    <!-- 空状态 -->
    <view class="empty" wx:if="{{!loading && messages.length === 0}}">
      <text class="empty-icon">🐱</text>
      <text>还没有留言，快来抢沙发~</text>
    </view>

    <!-- 加载更多 -->
    <view class="loading-more" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
    <view class="loading-more" wx:if="{{!hasMore && messages.length > 0}}">
      <text>没有更多了</text>
    </view>
  </view>

  <!-- 底部输入栏 -->
  <view class="input-bar">
    <!-- 公开/定向切换 -->
    <view class="visibility-toggle">
      <view
        class="vis-btn {{visibility === 'public' ? 'active' : ''}}"
        data-vis="public"
        bindtap="onToggleVisibility"
      >公开</view>
      <view
        class="vis-btn {{visibility === 'targeted' ? 'active' : ''}}"
        data-vis="targeted"
        bindtap="onToggleVisibility"
      >定向</view>
    </view>

    <!-- 定向发布：用户名输入 -->
    <view class="target-input-wrap" wx:if="{{showTargetInput}}">
      <input
        class="target-input"
        placeholder="输入用户名，多个用逗号分隔"
        value="{{visibleTo}}"
        bindinput="onVisibleToInput"
        placeholder-class="placeholder"
      />
    </view>

    <!-- 留言输入 + 发送 -->
    <view class="input-row">
      <input
        class="input-field"
        placeholder="写点什么..."
        value="{{inputContent}}"
        bindinput="onInput"
        confirm-type="send"
        bindconfirm="onSend"
        maxlength="500"
      />
      <button class="send-btn" bindtap="onSend" disabled="{{!inputContent || sending}}">
        {{sending ? '...' : '发送'}}
      </button>
    </view>
  </view>

</view>
