/* pages/messages/messages.wxss */
.messages-page {
  min-height: 100vh;
  background: #f5f7f5;
  padding-bottom: 120rpx;
}

/* 留言列表 */
.message-list {
  padding: 20rpx 24rpx;
}

/* 单条留言 */
.message-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.message-item.mine {
  border-left: 6rpx solid #2db84d;
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.message-username {
  font-size: 26rpx;
  font-weight: 600;
  color: #2db84d;
}

.message-item.mine .message-username {
  color: #ff6b35;
}

.message-time {
  font-size: 22rpx;
  color: #bbb;
}

.message-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 200rpx 0;
  color: #ccc;
  font-size: 28rpx;
}

.empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

/* 加载更多 */
.loading-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}

/* 底部输入栏 */
.input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.input-field {
  flex: 1;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  height: 64rpx;
}

.send-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  background: #2db84d;
  color: #fff;
  font-size: 28rpx;
  border: none;
  border-radius: 32rpx;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
}

.send-btn[disabled] {
  background: #ccc;
  color: #fff;
}

.send-btn::after {
  border: none;
}
